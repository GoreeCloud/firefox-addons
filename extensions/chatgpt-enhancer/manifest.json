{
  "manifest_version": 3,
  "name": "GoreeCloud ChatGPT Enhancer",
  "version": "0.1.3",
  "description": "Local-first Firefox productivity, navigation, export, prompt, and accessibility enhancements for ChatGPT.",
  "homepage_url": "https://github.com/GoreeCloud/firefox-addons",
  "incognito": "not_allowed",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "GoreeCloud ChatGPT Enhancer",
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared/settings.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-enhancer@goreecloud.com",
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "assets/icon.svg",
    "32": "assets/icon.svg",
    "48": "assets/icon.svg",
    "64": "assets/icon.svg",
    "96": "assets/icon.svg",
    "128": "assets/icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
