{
  "manifest_version": 3,
  "name": "GoreeCloud Browser Hardening",
  "version": "0.1.0",
  "description": "Native Firefox privacy and security hardening with reversible WebExtension controls and Firefox Enterprise policy export.",
  "homepage_url": "https://github.com/GoreeCloud/firefox-addons/tree/main/extensions/firefox-hardening",
  "icons": {
    "16": "icons/firefox-hardening.svg",
    "32": "icons/firefox-hardening.svg",
    "48": "icons/firefox-hardening.svg",
    "64": "icons/firefox-hardening.svg",
    "96": "icons/firefox-hardening.svg",
    "128": "icons/firefox-hardening.svg"
  },
  "permissions": [
    "browserSettings",
    "privacy",
    "storage"
  ],
  "action": {
    "default_title": "GoreeCloud Browser Hardening",
    "default_icon": "icons/firefox-hardening.svg",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-hardening@goreecloud.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
